# Copier ce fichier en .env et adapter les valeurs

# ── Caméra ──────────────────────────────────────────────────────────────────
CAMERA_IP=192.168.1.150
CAMERA_RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASS=admin

# URL RTSP complète (optionnel — remplace les champs ci-dessus si définie)
# RTSP_URL=rtsp://admin:admin@192.168.1.150:554/stream

# Transport RTSP : tcp (recommandé) ou udp
RTSP_TRANSPORT=tcp

# ── Serveur ─────────────────────────────────────────────────────────────────
PORT=8000
HLS_DIR=/tmp/hls-stream

# ── Accès distant ───────────────────────────────────────────────────────────
# Tunnel : "cloudflared" | "ngrok" | "none"
TUNNEL=none

# Authentification HTTP basique (FORTEMENT recommandée si TUNNEL != none)
AUTH_USER=
AUTH_PASS=

# Token ngrok (optionnel — uniquement pour ngrok avec sous-domaine fixe)
# NGROK_TOKEN=xxxxxxxxxxxxxxxxxxxx
