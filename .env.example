# Copier ce fichier en .env et adapter les valeurs
CAMERA_IP=192.168.1.150
CAMERA_RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASS=admin

# URL RTSP complète (optionnel — remplace les champs ci-dessus si définie)
# RTSP_URL=rtsp://admin:admin@192.168.1.150:554/stream

# Transport RTSP : tcp (recommandé) ou udp
RTSP_TRANSPORT=tcp

# Port du serveur web
PORT=8000

# Dossier temporaire pour les segments HLS
HLS_DIR=/tmp/hls-stream
